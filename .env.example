# Plate Plan Environment Configuration
# Copy this file to .env.local and fill in your values.

# ── AI provider (powered by Neuron AI) ─────────────────────────────
# One of: gemini | openai | anthropic | ollama | mistral | deepseek | grok | openai_like
AI_PROVIDER=gemini

# Model name. Optional for gemini, openai, anthropic, ollama, mistral and deepseek
# (a sensible default is used); required for grok and openai_like.
AI_MODEL=

# API key for the selected provider. You can also use the provider-specific
# variable instead: GEMINI_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY,
# MISTRAL_API_KEY, DEEPSEEK_API_KEY or XAI_API_KEY.
AI_API_KEY=

# Endpoint for ollama (default http://localhost:11434/api; from Docker use
# http://host.docker.internal:11434/api) or for any openai_like server.
AI_BASE_URL=

# Legacy Gemini settings (still supported when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Application settings ──────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true

# Database Path (defaults to data/diet.sqlite)
DB_PATH=/var/www/html/data/diet.sqlite

# ── Request protection ────────────────────────────────────────────
# Plate Plan has no login, so it only answers requests addressed to these
# hosts: localhost, 127.0.0.1, ::1 and host.docker.internal. Add more if you
# open it from another device on your network (comma-separated), e.g.
# PLATE_PLAN_ALLOWED_HOSTS=192.168.1.20,plate-plan.local
PLATE_PLAN_ALLOWED_HOSTS=

# Requests from other websites are blocked. To let a browser tool such as the
# MCP Inspector call the API or MCP server, list its origin here, e.g.
# PLATE_PLAN_ALLOWED_ORIGINS=http://localhost:6274
PLATE_PLAN_ALLOWED_ORIGINS=
